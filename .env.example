# Copia este ficheiro para '.env' e ajusta ao teu gosto.

# --- Cérebro (Ollama) ---
OLLAMA_HOST=http://localhost:11434
JARVIS_MODEL=llama3.1
JARVIS_TEMPERATURE=0.7

# --- Identidade ---
JARVIS_NAME=Sony
JARVIS_LANGUAGE=pt-PT

# --- Servidor web (HUD) ---
JARVIS_HTTP_HOST=127.0.0.1
JARVIS_HTTP_PORT=5000

# --- Segurança ---
# Permitir comandos do sistema (executar_comando). 0 = desligado, 1 = ligado.
JARVIS_ALLOW_SHELL=0

# Verificação de segurança automática de X em X horas (0 = desligado).
JARVIS_SECURITY_INTERVAL=0

# --- Memória ---
JARVIS_MAX_HISTORY=20
